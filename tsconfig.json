{
  "compilerOptions": {
    "strict": true, "module": "commonjs", "moduleResolution": "node", "target": "es2020",
    "lib": ["es2020", "es2022.error"], "removeComments": true, "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true, "noImplicitAny": true, "declaration": true, "sourceMap": true,
    "outDir": "./dist", "rootDir": "./src", "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
