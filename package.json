{
  "name": "@mattxcz/n8n-nodes-facebook-scraper",
  "version": "1.0.0",
  "description": "n8n community node for extracting Facebook Reel and post (incl. group posts) metadata, images and direct video URLs, public-first with optional logged-in session",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/MattXcz/n8n-nodes-facebook-scraper",
  "author": {
    "name": "Matouš Bečvář",
    "email": "matous.becvar@eurowag.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MattXcz/n8n-nodes-facebook-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/MattXcz/n8n-nodes-facebook-scraper/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/mattxcz"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FacebookSessionApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FacebookReels/FacebookReels.node.js"
    ]
  },
  "keywords": [
    "facebook",
    "groups",
    "metadata",
    "n8n",
    "n8n-community-node-package",
    "posts",
    "reels",
    "scraper",
    "video"
  ],
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "cp src/nodes/FacebookReels/*.svg dist/nodes/FacebookReels/",
    "dev": "tsc --watch",
    "test": "jest",
    "probe": "node dist/probe.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.1",
    "jest": "^29.7.0",
    "n8n-workflow": "1.82.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}
